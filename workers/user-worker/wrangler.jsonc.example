{
  "name": "USER_WORKER_NAME",
  "account_id": "ACCOUNT_ID",
  "main": "src/user-worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ], 
  
  "observability": { 
	"enabled": true
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  },

  // Raised alongside the orphan-sweep per-run caps; decrypting many case-data
  // records during the scheduled sweep is CPU-bound, not just I/O-bound.
  "limits": {
    "cpu_ms": 300000
  },

   "kv_namespaces": [
    {
      "binding": "USER_DB",
      "id": "KV_STORE_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STRIAE_DATA",
      "bucket_name": "DATA_BUCKET_NAME"
    },
    {
      "binding": "STRIAE_FILES",
      "bucket_name": "FILES_BUCKET_NAME"
    },
    {
      "binding": "STRIAE_CONFIG",
      "bucket_name": "CONFIG_BUCKET_NAME"
    }
  ],

  "placement": { "mode": "smart" }
}